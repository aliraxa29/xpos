# X POS frontend environment
#
# Copy to `.env` and edit. `.env` and `.env.local` are gitignored; this file is the committed
# reference, so add every new variable here too.
#
#   cp .env.example .env
#
# Precedence, highest first:
#   1. Variables already exported in your shell, or set inline (`CYPRESS_SLOW_MO=1500 yarn ...`)
#   2. `.env.local`  - your machine only
#   3. `.env`        - the project's defaults
#
# Loaded by `scripts/loadEnv.mjs`, which is called from `cypress.config.ts`,
# `scripts/run-cypress.mjs` and `vite.config.electron.ts`. Vite reads `.env` natively for
# `VITE_`-prefixed keys; everything else needs that loader, which is why it exists.


# --- End-to-end tests -------------------------------------------------------------------------

# Where Cypress points. `yarn test:e2e` starts a Vite dev server here if nothing is listening.
# Set this to a real site to run the specs against it instead - see tests/e2e/README.md, and note
# that the specs assume the stubbed backend, so they will need fixture data to pass.
CYPRESS_BASE_URL=http://localhost:5174

# Milliseconds each action is held on screen, so a run can be watched rather than just measured.
# 0 disables it entirely, which is what CI wants. `yarn test:e2e:demo` defaults this to 700.
CYPRESS_SLOW_MO=0


# --- Electron desktop app ---------------------------------------------------------------------

# The Frappe/ERPNext server the desktop app talks to. Only a development default: a packaged
# build ships without a .env, and the app stores the URL the user picks in its own config.
XPOS_SERVER_URL=http://localhost:8000

# VITE_DEV_SERVER_URL is set automatically by `yarn dev:electron` (vite-plugin-electron tells the
# main process where the renderer is). Do not set it by hand.
